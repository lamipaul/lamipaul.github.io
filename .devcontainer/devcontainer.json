{
  "name": "Paul Best MkDocs",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "MkDocs preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "mkdocs build --strict",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "yzhang.markdown-all-in-one",
        "redhat.vscode-yaml"
      ]
    }
  }
}
